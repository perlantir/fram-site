# Postgres — set to your Vercel/Neon connection string in production
DATABASE_URL="postgres://user:password@localhost:5432/fram"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-random-32-byte-secret"
AUTH_URL="http://localhost:3000"
# Set to "true" in prod behind a proxy so cookies are marked Secure
AUTH_TRUST_HOST="true"

# Email (Resend) — used for inquiry notifications + password resets
RESEND_API_KEY=""
NOTIFY_EMAIL="hello@fram.example"
FROM_EMAIL="FRAM <no-reply@fram.example>"

# Cloudflare Turnstile — public + secret keys for spam protection on Inquire
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Bootstrap: create first admin at /admin/bootstrap
BOOTSTRAP_TOKEN="replace-with-one-time-token"
